<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (RemoteViews: only simple framework views) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <ImageView android:id="@+id/w_art" android:layout_width="64dp" android:layout_height="64dp"
        android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="Album art" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginLeft="12dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:text="Tape Deck"
                android:textColor="#FFFFF3D6" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:text="Tap to play"
                android:textColor="#FFD9B98A" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
            <ImageButton android:id="@+id/w_prev" android:layout_width="44dp" android:layout_height="40dp" android:background="@null"
                android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" />
            <ImageButton android:id="@+id/w_play" android:layout_width="52dp" android:layout_height="40dp" android:background="@null"
                android:src="@android:drawable/ic_media_play" android:contentDescription="Play or pause" />
            <ImageButton android:id="@+id/w_next" android:layout_width="44dp" android:layout_height="40dp" android:background="@null"
                android:src="@android:drawable/ic_media_next" android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
